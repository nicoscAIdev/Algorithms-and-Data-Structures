% Conocer para una determinada venta de producto cuyo código se deberá especificar,
% los siguientes datos: cliente, cantidad pedida, denominación del
% producto y su precio unitario. Predicado sugerido para esta regla

regla1(CodVenta,Cliente,CantPedida,DenomProd,PrecioUnit):-
     venta(CodVenta,CodProd,Cliente,_,CantPedida,_),
    producto(CodProd,DenomProd,_,PrecioUnit,_,_).

% Generar una lista con todos los nombres de las categorías de aquellos
% productos que tengan un precio superior a un determinado valor y cuya
% cantidad de proveedores sea mayor o igual a 3. Considerar la
% posibilidad de que la lista generada pueda figurar categorías
% repetidas, por lo que se deberá evitar esta situación

regla2(Valor,Lista):-
     findall(Nombre,
             (   producto(_,_,_,Precio,Categoria,Proovedores),
                 categoria(Categoria, Nombre),
                 Precio > Valor,
                 length(Proovedores, Cant),
                 Cant >= 3),
             Lista),
     sort(Lista,Nombre).

