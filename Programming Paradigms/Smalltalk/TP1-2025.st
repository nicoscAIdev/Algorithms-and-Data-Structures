Object subclass: #MotorAcceso	instanceVariableNames: 'politicas'	classVariableNames: ''	package: 'TP1-2025'!!MotorAcceso methodsFor: 'initialization' stamp: 'Nicosabena 4/19/2025 16:09'!initialize 	politicas := OrderedCollection new.	! !!MotorAcceso methodsFor: 'converting' stamp: 'Nicosabena 4/30/2025 18:00'!asString	| salida |		salida := 'Las politicas que poseen nivel de privilegio valido son: ', politicas size asString, 	String cr.	salida := salida , 'Lista de Politicas:', String cr.	politicas do: [:ref | salida := salida , ref asString , String cr.].	^ salida.! !!MotorAcceso methodsFor: 'metodo negocio' stamp: 'Nicosabena 4/30/2025 18:09'!existePoliticaAplicacion: unNivel	| politica |	politica := politicas		detect: [ :ref | (ref isKindOf: Aplicacion) and: [ref nivelPrivilegios >= unNivel] ]		ifNone: [ nil ].	^ politica		ifNil: [ 'La politica no fue encontrada. ' ]		ifNotNil: [ politica descripcion].! !!MotorAcceso methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!politicas	^ politicas! !!MotorAcceso methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!politicas: anObject	politicas := anObject! !!MotorAcceso methodsFor: 'metodo de negocio' stamp: 'Nicosabena 4/30/2025 18:10'!validarUsuario: unUsuario		    | politicasHabilitadas |	    (unUsuario isKindOf: Usuario)        ifFalse: [ ^'El valor ingresado no pertenece a la clase Usuario25' ].    politicasHabilitadas := politicas select: [:p | p habilitada].    politicasHabilitadas isEmpty ifTrue: [ ^'El usuario es valido' ].    (politicasHabilitadas allSatisfy: [:p | p validarRegla: unUsuario ])        ifTrue: [ ^'El usuario es valido. ' ]        ifFalse: [ ^'El usuario no es valido. ' ].! !!MotorAcceso methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/30/2025 17:47'!agregarPolitica: unaPolitica  			(politicas detect: [:p | p codigo = unaPolitica codigo] ifNone: [nil])    ifNil: [politicas agregarPolitica: unaPolitica].! !Object subclass: #Politica	instanceVariableNames: 'codigo descripcion habilitada'	classVariableNames: ''	package: 'TP1-2025'!!Politica methodsFor: 'initialization' stamp: 'Nicosabena 4/29/2025 23:43'!initialize	codigo := 0.	descripcion := ''.	habilitada := false.	! !!Politica methodsFor: 'converting' stamp: 'Nicosabena 4/29/2025 18:42'!asString 	|salida|		salida := String cr, 'El codigo de la Politica es: ', codigo asString, '.', String cr, 	'Su descripcion es: ', descripcion asString, String cr, 	'La condicion de habilitamiento es: ', habilitada asString. 									^salida. ! !!Politica methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/19/2025 18:47'!validarRegla: regla^self subclassResponsibility! !!Politica methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!descripcion: anObject	descripcion := anObject! !!Politica methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!codigo	^ codigo! !!Politica methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!descripcion	^ descripcion! !!Politica methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!codigo: anObject	codigo := anObject! !!Politica methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!habilitada	^ habilitada! !!Politica methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!habilitada: anObject	habilitada := anObject! !Politica subclass: #Aplicacion	instanceVariableNames: 'nivelPrivilegios'	classVariableNames: ''	package: 'TP1-2025'!!Aplicacion methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!nivelPrivilegios	^ nivelPrivilegios! !!Aplicacion methodsFor: 'accessing' stamp: 'Nicosabena 4/19/2025 15:58'!nivelPrivilegios: anObject		 (anObject >= 1 and: [anObject <= 10])    ifTrue: [nivelPrivilegios := anObject]    ifFalse: [^false].! !!Aplicacion methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/30/2025 18:10'!validarRegla: unUsuario    ^ (unUsuario isKindOf: Usuario)        and: [unUsuario nivelPrivilegios >= (self nivelPrivilegios * 2)].	! !!Aplicacion methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 15:53'!asString     | salida |        salida := super asString, String cr,              'El nivel de privilegios que tiene es: ', nivelPrivilegios asString, String cr.        ^salida.! !!Aplicacion methodsFor: 'initialization' stamp: 'Nicosabena 4/18/2025 18:56'!initialize super initialize.	nivelPrivilegios := 0.! !Politica subclass: #Networking	instanceVariableNames: 'ipDesde ipHasta'	classVariableNames: ''	package: 'TP1-2025'!!Networking methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipDesde: anObject	ipDesde := anObject! !!Networking methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipHasta: anObject	ipHasta := anObject! !!Networking methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipHasta	^ ipHasta! !!Networking methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipDesde	^ ipDesde! !!Networking methodsFor: 'initialization' stamp: 'Nicosabena 4/29/2025 23:55'!initialize super initialize.	ipDesde := 0.	ipHasta := 0.! !!Networking methodsFor: 'converting' stamp: 'Nicosabena 4/29/2025 18:45'!asString	|salida|		salida := super asString, 'IP Desde: ', ipDesde asString, '. IP Hasta: ', ipHasta asString.		^salida.! !!Networking methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/30/2025 18:10'!validarRegla: unUsuario    ^ (unUsuario isKindOf: Usuario)        and: [unUsuario direccionIP between: self ipDesde and: self ipHasta].! !Object subclass: #Usuario	instanceVariableNames: 'email clave direccionIP nivelPrivilegios'	classVariableNames: ''	package: 'TP1-2025'!!Usuario methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 16:08'!asString	|salida|		salida := 'El Mail es: ', email asString, ' La clave es: ', clave asString, '. La direccion es: ', direccionIP asString, '. El nivel de privilegio es de: ', nivelPrivilegios asString.		^salida.! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!clave: anObject	clave := anObject! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!email: anObject	email := anObject! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!direccionIP	^ direccionIP! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!nivelPrivilegios	^ nivelPrivilegios! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/30/2025 12:47'!direccionIP: unaIP    direccionIP := unaIP.! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!clave	^ clave! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!email	^ email! !!Usuario methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!nivelPrivilegios: anObject	nivelPrivilegios := anObject! !!Usuario methodsFor: 'initialization' stamp: 'Nicosabena 4/30/2025 12:44'!initialize	email := ''.	clave := ''.	direccionIP := 0.	nivelPrivilegios := 0.! !