Object subclass: #MotorAcceso25	instanceVariableNames: 'politicas'	classVariableNames: ''	package: 'TP1-2025'!!MotorAcceso25 methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/19/2025 18:51'!add: unaPolitica  			(politicas detect: [:p | p codigo = unaPolitica codigo] ifNone: [nil])    ifNil: [politicas add: unaPolitica].! !!MotorAcceso25 methodsFor: 'initialization' stamp: 'Nicosabena 4/19/2025 16:09'!initialize 	politicas := OrderedCollection new.	! !!MotorAcceso25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!politicas	^ politicas! !!MotorAcceso25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!politicas: anObject	politicas := anObject! !!MotorAcceso25 methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 18:08'!asString	|salida|		salida := 'Las politicas que poseen nivel de privilegio valido son: ', politicas size asString.		^salida.! !Object subclass: #Politica25	instanceVariableNames: 'codigo descripcion habilitada'	classVariableNames: ''	package: 'TP1-2025'!!Politica25 methodsFor: 'initialization' stamp: 'Nicosabena 4/18/2025 18:44'!initialize	codigo := 0.	descripcion := ''.	habilitada := false.	! !!Politica25 methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 16:56'!asString 	|salida|		salida := 'El codigo de la Politica es: ', codigo asString, '.', String cr, ' Su descripcion es: ',				descripcion asString, '. La condicion de habilitamiento es: ', habilitada asString. 									^salida. ! !!Politica25 methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/19/2025 18:47'!validarRegla: regla^self subclassResponsibility! !!Politica25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!descripcion: anObject	descripcion := anObject! !!Politica25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!codigo	^ codigo! !!Politica25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!descripcion	^ descripcion! !!Politica25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!codigo: anObject	codigo := anObject! !!Politica25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!habilitada	^ habilitada! !!Politica25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!habilitada: anObject	habilitada := anObject! !Politica25 subclass: #Aplicacion25	instanceVariableNames: 'nivelPrivilegios'	classVariableNames: ''	package: 'TP1-2025'!!Aplicacion25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!nivelPrivilegios	^ nivelPrivilegios! !!Aplicacion25 methodsFor: 'accessing' stamp: 'Nicosabena 4/19/2025 15:58'!nivelPrivilegios: anObject		 (anObject >= 1 and: [anObject <= 10])    ifTrue: [nivelPrivilegios := anObject]    ifFalse: [^false].! !!Aplicacion25 methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 15:53'!asString     | salida |        salida := super asString, String cr,              'El nivel de privilegios que tiene es: ', nivelPrivilegios asString, String cr.        ^salida.! !!Aplicacion25 methodsFor: 'initialization' stamp: 'Nicosabena 4/18/2025 18:56'!initialize super initialize.	nivelPrivilegios := 0.! !!Aplicacion25 methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/19/2025 18:56'!validarRegla: regla	(regla * 2 <= self nivelPrivilegios) ifTrue:[^true.]											 ifFalse:[^false.].! !Politica25 subclass: #Networking25	instanceVariableNames: 'ipDesde ipHasta'	classVariableNames: ''	package: 'TP1-2025'!!Networking25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipDesde: anObject	ipDesde := anObject! !!Networking25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipHasta: anObject	ipHasta := anObject! !!Networking25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipHasta	^ ipHasta! !!Networking25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!ipDesde	^ ipDesde! !!Networking25 methodsFor: 'initialization' stamp: 'Nicosabena 4/19/2025 19:36'!initialize super initialize.	ipDesde := 300.	ipHasta := 1000.! !!Networking25 methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 16:17'!asString	|salida|		salida := super asString, 'IP Desde: ', ipDesde asString, '. IP Hasta: ', ipHasta asString.		^salida.! !!Networking25 methodsFor: 'as yet unclassified' stamp: 'Nicosabena 4/19/2025 19:54'!validarRegla: regla	|salida|	salida := (regla between: ipDesde and: ipHasta) ifTrue:[true]																		ifFalse:[false].																			^salida.! !Object subclass: #Usuario25	instanceVariableNames: 'email clave direccionIP nivelPrivilegios'	classVariableNames: ''	package: 'TP1-2025'!!Usuario25 methodsFor: 'converting' stamp: 'Nicosabena 4/19/2025 16:08'!asString	|salida|		salida := 'El Mail es: ', email asString, ' La clave es: ', clave asString, '. La direccion es: ', direccionIP asString, '. El nivel de privilegio es de: ', nivelPrivilegios asString.		^salida.! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!clave: anObject	clave := anObject! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!email: anObject	email := anObject! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!direccionIP	^ direccionIP! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!nivelPrivilegios	^ nivelPrivilegios! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!direccionIP: anObject	direccionIP := anObject! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!clave	^ clave! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!email	^ email! !!Usuario25 methodsFor: 'accessing' stamp: 'Nicosabena 4/18/2025 18:32'!nivelPrivilegios: anObject	nivelPrivilegios := anObject! !!Usuario25 methodsFor: 'initialization' stamp: 'Nicosabena 4/19/2025 16:06'!initialize	email := ''.	clave := ''.	direccionIP := 0.	nivelPrivilegios := 0.! !