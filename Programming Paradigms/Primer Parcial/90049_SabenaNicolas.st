Object subclass: #Escuderia	instanceVariableNames: 'nombre pais vehiculos'	classVariableNames: ''	package: '90049_SabenaNicolas'!!Escuderia methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:08'!vehiculos: anObject	vehiculos := anObject! !!Escuderia methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:08'!nombre	^ nombre! !!Escuderia methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:08'!pais: anObject	pais := anObject! !!Escuderia methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:08'!nombre: anObject	nombre := anObject! !!Escuderia methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:08'!pais	^ pais! !!Escuderia methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:08'!vehiculos	^ vehiculos! !!Escuderia methodsFor: 'initialization' stamp: 'nico 6/21/2025 09:17'!initialize 	nombre:= ''.	pais := ''.	vehiculos := OrderedCollection new.! !!Escuderia methodsFor: 'as yet unclassified' stamp: 'nico 6/21/2025 10:07'!rendimientoPorModelo: unValor	|listaMismoModelo cantidadAutosModelo sumador r|		sumador:=0.		listaMismoModelo := vehiculos select:[:vehiculo | (vehiculo modelo) = unValor].		cantidadAutosModelo := listaMismoModelo size.		listaMismoModelo do:[:vehiculo | sumador:= vehiculo rendimiento].		r:= sumador / cantidadAutosModelo.		^r.! !!Escuderia methodsFor: 'as yet unclassified' stamp: 'nico 6/21/2025 10:00'!vehiculoPorEficiencia: max y: min 	|vehiculoEficiencia s|	vehiculoEficiencia:= vehiculos detect:[:vehiculo| (vehiculo eficiencia) between: min and: max]ifNone:[vehiculoEficiencia := 0].		(vehiculoEficiencia = 0)ifTrue:[s:= 0]									ifFalse:[s:= vehiculoEficiencia potencia]. 		^s.	 ! !!Escuderia methodsFor: 'adding' stamp: 'nico 6/21/2025 09:19'!addVehiculos: unVehiculo	((unVehiculo potencia) >= 20)ifTrue: [vehiculos add: unVehiculo].! !Object subclass: #Vehiculo	instanceVariableNames: 'marca modelo potencia'	classVariableNames: ''	package: '90049_SabenaNicolas'!!Vehiculo methodsFor: 'converting' stamp: 'nico 6/21/2025 09:11'!asString 	|s|		s:= 'La marca es: ', marca asString, ' modelo: ', modelo asString, ' con una potencia de: ', potencia asString.		^s.! !!Vehiculo methodsFor: 'as yet unclassified' stamp: 'nico 6/21/2025 09:19'!rendimientoself subclassResponsibility.! !!Vehiculo methodsFor: 'initialization' stamp: 'nico 6/21/2025 09:09'!initialize 	marca:=''.	modelo:=''.	potencia :=0.! !!Vehiculo methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:06'!marca: anObject	marca := anObject! !!Vehiculo methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:06'!modelo: anObject	modelo := anObject! !!Vehiculo methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:06'!marca	^ marca! !!Vehiculo methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:06'!modelo	^ modelo! !!Vehiculo methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:06'!potencia	^ potencia! !!Vehiculo methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:06'!potencia: anObject	potencia := anObject! !Vehiculo subclass: #Formula1	instanceVariableNames: 'velocidadMaxima eficiencia'	classVariableNames: ''	package: '90049_SabenaNicolas'!!Formula1 methodsFor: 'as yet unclassified' stamp: 'nico 6/21/2025 09:20'!rendimiento	|r|		r:= potencia * velocidadMaxima * eficiencia.		^r.! !!Formula1 methodsFor: 'converting' stamp: 'nico 6/21/2025 09:13'!asString 		|s|		s:= super asString, ' tiene una velocidad maxima de: ', velocidadMaxima asString, ' y una eficiencia de: ', eficiencia asString.		^s.! !!Formula1 methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!velocidadMaxima: anObject	velocidadMaxima := anObject! !!Formula1 methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!eficiencia	^ eficiencia! !!Formula1 methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!velocidadMaxima	^ velocidadMaxima! !!Formula1 methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!eficiencia: anObject	eficiencia := anObject! !!Formula1 methodsFor: 'initialization' stamp: 'nico 6/21/2025 09:45'!initialize super initialize.	velocidadMaxima:=0.	eficiencia:=0.! !Vehiculo subclass: #Rally	instanceVariableNames: 'tipoTerreno pesoTotal'	classVariableNames: ''	package: '90049_SabenaNicolas'!!Rally methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!pesoTotal	^ pesoTotal! !!Rally methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!pesoTotal: anObject	pesoTotal := anObject! !!Rally methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!tipoTerreno	^ tipoTerreno! !!Rally methodsFor: 'accessing' stamp: 'nico 6/21/2025 09:09'!tipoTerreno: anObject	tipoTerreno := anObject! !!Rally methodsFor: 'initialization' stamp: 'nico 6/21/2025 09:15'!initialize super initialize.	pesoTotal := 0.		tipoTerreno := 1.	! !!Rally methodsFor: 'as yet unclassified' stamp: 'nico 6/21/2025 09:51'!rendimiento	|r porcTerreno|	porcTerreno := 1.0.		(tipoTerreno = 1) ifTrue:[porcTerreno := 1.5]							ifFalse:[(tipoTerreno = 2)ifTrue:[porcTerreno := 1.3]].	r:= potencia / pesoTotal * porcTerreno.	^r.! !!Rally methodsFor: 'converting' stamp: 'nico 6/21/2025 09:16'!asString 	|s|		s:= super asString, ' el peso total es de: ', pesoTotal asString, ' el tipo de terreno es: ', tipoTerreno asString.		^s.! !