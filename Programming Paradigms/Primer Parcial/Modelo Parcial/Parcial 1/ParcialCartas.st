Object subclass: #Carta22	instanceVariableNames: 'palo figura'	classVariableNames: ''	package: 'ParcialCartas'!!Carta22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:43'!figura	^ figura! !!Carta22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:43'!figura: anObject	figura := anObject! !!Carta22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:43'!palo: anObject	palo := anObject! !!Carta22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:43'!palo	^ palo! !Carta22 subclass: #CartaLetra22	instanceVariableNames: 'letra'	classVariableNames: ''	package: 'ParcialCartas'!!CartaLetra22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:45'!letra: anObject	letra := anObject! !!CartaLetra22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:45'!letra	^ letra! !!CartaLetra22 methodsFor: 'initialization' stamp: 'Nicosabena 6/19/2025 22:44'!initialize super initialize.	letra := 'n/a'.! !!CartaLetra22 methodsFor: 'converting' stamp: 'Nicosabena 6/19/2025 22:45'!asString 	|s|		s:= 'Letra: ', letra.		^s.! !!CartaLetra22 methodsFor: 'metodos de negocio' stamp: 'Nicosabena 6/20/2025 11:03'!valor	|v|	v:= 0.	(letra = 'A' or: letra = 'J')ifTrue:[														v := 65														]											ifFalse:[v := 74												]. 	^v.! !Carta22 subclass: #CartaNumerica22	instanceVariableNames: 'numero'	classVariableNames: ''	package: 'ParcialCartas'!!CartaNumerica22 methodsFor: 'accessing' stamp: 'Nicosabena 6/19/2025 21:45'!numero	^ numero! !!CartaNumerica22 methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 10:49'!numero: anObject	|valor|	(anObject isNumber) ifTrue:[									(anObject between: 2 and: 10)ifTrue:[																				 numero := anObject.																					 ]										].		! !!CartaNumerica22 methodsFor: 'converting' stamp: 'Nicosabena 6/19/2025 22:45'!asString 	|s| 		s:= super asString, ' El numero es: ', numero asString. 		^s.! !!CartaNumerica22 methodsFor: 'initialization' stamp: 'Nicosabena 6/19/2025 21:49'!initialize 	super initialize.	numero := 0.! !!CartaNumerica22 methodsFor: 'metodos de negocio' stamp: 'Nicosabena 6/20/2025 10:55'!valor	^numero * 10.! !Object subclass: #Partida22	instanceVariableNames: 'numero cartas'	classVariableNames: ''	package: 'ParcialCartas'!!Partida22 methodsFor: 'converting' stamp: 'Nicosabena 6/20/2025 11:16'!asString |s|s:= 'Numero de partida: ', numero asString.s:= s, self mostrarCartas.^s.! !!Partida22 methodsFor: 'initialization' stamp: 'Nicosabena 6/20/2025 11:13'!initialize 	numero := 0.	cartas := OrderedCollection new.! !!Partida22 methodsFor: 'metodos de negocio' stamp: 'Nicosabena 6/20/2025 11:18'!mostrarCartas |s|s:= ''.cartas do:[:c|s:= s, c asString, String cr].^s.! !!Partida22 methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 11:12'!cartas: anObject	cartas := anObject! !!Partida22 methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 11:12'!numero	^ numero! !!Partida22 methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 11:12'!numero: anObject	numero := anObject! !!Partida22 methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 11:12'!cartas	^ cartas! !