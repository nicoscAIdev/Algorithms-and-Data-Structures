Object subclass: #Editorial	instanceVariableNames: 'libros'	classVariableNames: ''	package: 'ParcialLibros'!!Editorial methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!libros: anObject	libros := anObject! !!Editorial methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!libros	^ libros! !!Editorial methodsFor: 'adding' stamp: 'Nicosabena 6/20/2025 19:27'!add: unLibro		(unLibro paginas >= 50)ifTrue:[libros add: unLibro].! !!Editorial methodsFor: 'initialization' stamp: 'Nicosabena 6/20/2025 19:21'!initialize 	libros := OrderedCollection new.! !!Editorial methodsFor: 'as yet unclassified' stamp: 'Nicosabena 6/20/2025 19:58'!tituloLibro: valorEdad	 |nombreTitulo libroEdad|	libroEdad  := libros detect:[:libro | (libro tipoEdad) = valorEdad]ifNone:[^'Error!!'].		nombreTitulo := libroEdad titulo.		^nombreTitulo.   ! !!Editorial methodsFor: 'as yet unclassified' stamp: 'Nicosabena 6/20/2025 19:53'!costoImpresion: unValor	|costoTotal listaContenido|		costoTotal:= 0.0.		listaContenido := libros select:[:libro | libro tipoContenido = unValor].		listaContenido do:[:libro | costoTotal := costoTotal + libro costoImpresion].! !Object subclass: #Libro	instanceVariableNames: 'titulo idioma paginas costo'	classVariableNames: ''	package: 'ParcialLibros'!!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!idioma	^ idioma! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!paginas: anObject	paginas := anObject! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!paginas	^ paginas! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!titulo	^ titulo! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!titulo: anObject	titulo := anObject! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!costo	^ costo! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!costo: anObject	costo := anObject! !!Libro methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:18'!idioma: anObject	idioma := anObject! !!Libro methodsFor: 'initialization' stamp: 'Nicosabena 6/20/2025 19:20'!initialize 		titulo := ''.	idioma := 1.	paginas := 0.	costo := 0.! !!Libro methodsFor: 'converting' stamp: 'Nicosabena 6/20/2025 19:22'!asString 	|s|		s:= 'El titulo es: ', titulo asString, ' La cantidad de paginas que tiene son: ', paginas asString, ' El idioma es: ', idioma asString, ' El costo es: ', costo asString.		^s.! !!Libro methodsFor: 'as yet unclassified' stamp: 'Nicosabena 6/20/2025 19:28'!costoImpresionself subclassResponsibility.! !Libro subclass: #Cientifico	instanceVariableNames: 'tipoContenido'	classVariableNames: ''	package: 'ParcialLibros'!!Cientifico methodsFor: 'converting' stamp: 'Nicosabena 6/20/2025 19:24'!asString	|s|		s:= super asString, 'El tipo de contenido es: ', tipoContenido asString.		^s.! !!Cientifico methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:19'!tipoContenido	^ tipoContenido! !!Cientifico methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:19'!tipoContenido: anObject	tipoContenido := anObject! !!Cientifico methodsFor: 'initialization' stamp: 'Nicosabena 6/20/2025 19:23'!initialize super initialize.	tipoContenido := 1.	! !!Cientifico methodsFor: 'as yet unclassified' stamp: 'Nicosabena 6/20/2025 19:35'!costoImpresion	|costoTotal porcIdioma porcTipoContenido|	(idioma = 1)ifTrue:[porcIdioma := 1.05].	(idioma = 2)ifTrue:[porcIdioma := 1.10].	(idioma = 3)ifTrue:[porcIdioma := 1.15].	(tipoContenido = 3)ifTrue:[porcTipoContenido := 1.05]. 	costoTotal  := (costo * porcIdioma * porcTipoContenido).	^costoTotal.! !Libro subclass: #Historico	instanceVariableNames: 'tipoEdad'	classVariableNames: ''	package: 'ParcialLibros'!!Historico methodsFor: 'initialization' stamp: 'Nicosabena 6/20/2025 19:25'!initialize super initialize.	tipoEdad := 1. ! !!Historico methodsFor: 'as yet unclassified' stamp: 'Nicosabena 6/20/2025 19:46'!costoImpresion	| costoTotal porcPaginas |	paginas > 500 ifTrue: [porcPaginas := 1.15]		ifFalse: [ 			paginas > 200 ifTrue: [porcPaginas := 1.10]				ifFalse: [					paginas > 100 ifTrue: [porcPaginas := 0.95]]].	costoTotal := costo * porcPaginas.	^ costoTotal! !!Historico methodsFor: 'converting' stamp: 'Nicosabena 6/20/2025 19:26'!asString	|s|		s:= super asString, 'Tipo de edad: ', tipoEdad asString.		^s.! !!Historico methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:19'!tipoEdad	^ tipoEdad! !!Historico methodsFor: 'accessing' stamp: 'Nicosabena 6/20/2025 19:19'!tipoEdad: anObject	tipoEdad := anObject! !